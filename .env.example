# GitHub token with read access to the repos you watch
# (fine-grained token with Issues: Read-only is enough)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# API key from https://workflowy.com/api-key
WORKFLOWY_API_KEY=

# Optional — Slack bot token (xoxb-…), required when config.json lists slackChannels.
# Scopes: channels:history, channels:read, users:read
# (private channels additionally need groups:history, groups:read)
#SLACK_BOT_TOKEN=

# Optional — auto-join public tracked channels the bot isn't in yet.
# Needs the channels:join bot scope. Note: joining posts a "joined the
# channel" system message that everyone in the channel can see.
#SLACK_AUTO_JOIN=false

# Optional — path to config.json, absolute or relative to the project root.
# Lets the config live outside this repo, e.g. in a private sibling repo
# shared with your team.
#CONFIG_PATH=../workflowy-sync-config/config.json

# Comma-separated list of repos to watch
GITHUB_REPOS=my-org/api, my-org/web

# Optional — where new tasks land ("inbox" or a bullet's node id)
#WORKFLOWY_PARENT_ID=inbox

# Optional — layout mode for created tasks
#WORKFLOWY_LAYOUT_MODE=todo

# Optional — minutes between polls in continuous mode
#POLL_INTERVAL_MINUTES=5

# Optional — set to true before the first run to import existing open issues
#BACKFILL_EXISTING=false
