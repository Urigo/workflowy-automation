{
  "defaults": {
    "parentId": "inbox",
    "searchRootId": "node-id-whose-whole-subtree-is-checked-for-existing-issues",
    "pullRequests": true
  },
  "repos": [
    { "repo": "my-org/api", "parentId": "node-id-for-api-issues" },
    { "repo": "my-org/web", "parentId": "node-id-for-web-issues", "searchRootId": "override-per-repo" },
    { "repo": "my-org/docs", "pullRequests": false },
    { "repo": "other-org/private-repo", "tokenEnv": "GITHUB_TOKEN_OTHER_ORG" }
  ],
  "slackChannels": [
    { "channel": "C0123ABCDE", "parentId": "node-id-for-this-channels-messages" }, // #ext-some-customer
    { "channel": "C0456FGHIJ, C0789KLMNO", "parentId": "node-id-shared-by-these-channels", "lookbackDays": 14 },
    { "channel": "C0ABCDEFGH", "track": false } // listed but not synced
  ]
}
